{
  "name": "pipkin",
  "version": "1.0.0",
  "description": "A small companion for big Pi sessions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madeleineostoja/pipkin.git"
  },
  "bugs": {
    "url": "https://github.com/madeleineostoja/pipkin/issues"
  },
  "homepage": "https://github.com/madeleineostoja/pipkin#readme",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "pi-package",
    "pipkin"
  ],
  "pi": {
    "extensions": [
      "./src/extensions/sandbox/index.ts",
      "./src/extensions/readonly/index.ts",
      "./src/extensions/context/index.ts",
      "./src/extensions/ui/index.ts",
      "./src/extensions/personality/index.ts",
      "./src/extensions/guidance/index.ts",
      "./src/extensions/lsp/index.ts",
      "./src/extensions/processes/index.ts",
      "./src/extensions/subagents/index.ts",
      "./src/extensions/implement/index.ts",
      "./src/extensions/reference/index.ts",
      "./src/extensions/web/index.ts",
      "./src/extensions/browser/index.ts",
      "./src/extensions/papercuts/index.ts",
      "./src/extensions/btw/index.ts"
    ]
  },
  "imports": {
    "#lib/*": "./src/lib/*.ts",
    "#ui/activity": "./src/extensions/ui/activity.ts",
    "#ui/status": "./src/extensions/ui/status.ts",
    "#sandbox/runtime": "./src/extensions/sandbox/runtime.ts",
    "#sandbox/bash": "./src/extensions/sandbox/bash-capability.ts",
    "#context/retained-result": "./src/extensions/context/retained-result.ts",
    "#subagents/runtime": "./src/extensions/subagents/runtime.ts",
    "#subagents/completion": "./src/extensions/subagents/managed-completion.ts",
    "#personality/session-name": "./src/extensions/personality/session-name.ts",
    "#test/*": "./test/support/*.ts"
  },
  "scripts": {
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --testTimeout 15000"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "@playwright/browser-chromium": "^1.62.0",
    "defuddle": "^0.19.2",
    "execa": "^10.0.1",
    "fs-native-extensions": "^1.5.0",
    "ipaddr.js": "^2.5.0",
    "linkedom": "^0.18.13",
    "p-queue": "^9.3.3",
    "playwright-core": "^1.62.0",
    "svelte-language-server": "0.17.19",
    "typescript": "5.7.3",
    "typescript-language-server": "4.3.3",
    "wreq-js": "^2.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1",
    "@prettier/plugin-oxc": "^0.1.4",
    "@types/node": "^22.20.1",
    "ajv": "^6.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "oxlint": "^0.15.15",
    "prettier": "^3.9.6",
    "typebox": "^1.3.12",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,js,json}": [
      "oxlint --fix",
      "prettier --write"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.84.0",
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@earendil-works/pi-tui": "^0.84.0",
    "typebox": "*"
  }
}
